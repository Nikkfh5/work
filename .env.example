# Скопировать в .env и заполнить реальными значениями
# cp .env.example .env

# ── Anthropic ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Telegram ───────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAF...
TELEGRAM_OWNER_CHAT_ID=123456789   # твой личный chat_id

# ── Email (Gmail с App Password) ───────────────
GMAIL_USER=yourbot@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Meetings ───────────────────────────────────
TLDV_API_KEY=...
GOOGLE_CALENDAR_CREDENTIALS_JSON=credentials.json   # путь к файлу

# ── Git токены воркеров ────────────────────────
GIT_TOKEN_PYTHON1=ghp_...
GIT_TOKEN_PYTHON2=ghp_...
GIT_TOKEN_CPP1=glpat-...
GIT_TOKEN_CPP2=glpat-...
GIT_TOKEN_GO1=ghp_...

# ── Система ────────────────────────────────────
DB_PATH=data/orchestrator.db
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=30
CLAUDE_CLI_PATH=claude
