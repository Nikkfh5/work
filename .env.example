# Скопировать в .env и заполнить реальными значениями
# cp .env.example .env
# НИКОГДА не коммитить .env в репозиторий!

# ── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAF...        # токен от @BotFather
TELEGRAM_OWNER_CHAT_ID=123456789            # твой личный chat_id (узнать через @userinfobot)

# ── Email (Gmail с App Password) ───────────────────────────────────────────
GMAIL_USER=yourbot@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx      # App Password из Google Account → Security
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Notion (опционально, Фаза 2) ───────────────────────────────────────────
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=...

# ── Git токены воркеров ────────────────────────────────────────────────────
GIT_TOKEN_JOB1=ghp_...                      # GitHub personal access token (job1)
# GIT_TOKEN_JOB2=ghp_...                    # добавлять по мере добавления job'ов

# ── Система ────────────────────────────────────────────────────────────────
DB_PATH=data/orchestrator.db
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=30
CLAUDE_CLI_PATH=claude

# ── Лимиты и таймауты ─────────────────────────────────────────────────────
WORKER_LEASE_TTL_SECONDS=300                # 5 минут lease на задачу
WORKER_TIMEOUT_SECONDS=1800                 # 30 минут таймаут воркера
LOG_RETENTION_DAYS=30
WORKTREE_RETENTION_DAYS=7
