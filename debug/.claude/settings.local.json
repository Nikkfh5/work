{
  "permissions": {
    "allow": [
      "Bash",
      "WebSearch",
      "WebFetch",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "Bash(semgrep --metrics=off --config .semgrep/rules/ .)",
      "Bash(pip install:*)",
      "Bash(ruff check:*)",
      "Bash(pkill -f \"python -m supervisor.main\")"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r /:*)",
      "Bash(rmdir /s:*)"
    ]
  }
}
